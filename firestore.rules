rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validStock() {
      return request.resource.data.keys().hasAll(['currentStock'])
        && request.resource.data.keys().hasOnly(['currentStock'])
        && request.resource.data.currentStock is int
        && request.resource.data.currentStock >= 0;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is int;
    }

    match /inventory/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() && validStock();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock'])
        && validStock();
    }

    match /ventas/{ventaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['fecha', 'items', 'total'])
        && request.resource.data.keys().hasOnly(['fecha', 'items', 'total'])
        && request.resource.data.fecha is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total == null;
    }
  }
}
